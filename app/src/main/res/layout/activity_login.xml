<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="ServisKu"
            android:textColor="@color/ink_color"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Masuk ke akunmu"
            android:textColor="@color/muted_color"
            android:textSize="15sp" />

        <!-- Name Field (Register Mode) -->
        <TextView
            android:id="@+id/lbl_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nama"
            android:textColor="@color/muted_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext"
            android:hint="Nama Lengkap"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink_color"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Email Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email"
            android:textColor="@color/muted_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext"
            android:hint="contoh@email.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink_color"
            android:textSize="16sp" />

        <!-- Password Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Kata sandi"
            android:textColor="@color/muted_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edittext"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ink_color"
            android:textSize="16sp" />

        <!-- Error Text -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="18dp"
            android:textColor="@color/red_color"
            android:textSize="13sp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_login_submit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="Masuk"
            android:textColor="@color/on_accent_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Switch Mode Button -->
        <TextView
            android:id="@+id/btn_switch_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="Belum punya akun? Daftar"
            android:textColor="@color/accent_color"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Demo Hint -->
        <TextView
            android:id="@+id/tv_demo_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Demo: budi@email.com / 123456"
            android:textColor="@color/muted_color"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>