<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:background="@color/surface_color">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ServisKu"
            android:textColor="@color/ink_color"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Notification Bell with Badge -->
        <FrameLayout
            android:id="@+id/btn_notif"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="@color/ink_color"
                android:contentDescription="Notifikasi"/>

            <TextView
                android:id="@+id/tv_notif_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="1"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Overflow Menu Dots -->
        <ImageView
            android:id="@+id/btn_more_options"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_dots"
            app:tint="@color/ink_color"
            android:contentDescription="Menu Options"/>

    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header_layout"
        android:background="@color/line_color"/>

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_color"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/accent_color"
        app:itemTextColor="@color/accent_color"
        app:elevation="8dp"/>

    <!-- Floating Action Button (+) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_service"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:src="@drawable/ic_plus"
        app:tint="@color/on_accent_color"
        app:backgroundTint="@color/accent_color"
        app:fabSize="normal"
        android:contentDescription="Tambah Servis"/>

    <!-- Main Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:layout_above="@id/bottom_navigation"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Vehicle Horizontal Chips RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vehicle_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- Vehicle Subtitle -->
            <TextView
                android:id="@+id/tv_vehicle_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Honda Vario 125 · 2021 · B 1234 XYZ"
                android:textColor="@color/muted_color"
                android:textSize="14sp"/>

            <!-- Odometer Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_odometer_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13.200 km"
                    android:textColor="@color/ink_color"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/btn_edit_odometer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/accent_color"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Ubah Odometer"/>
            </LinearLayout>

            <!-- Main Next Service Card -->
            <LinearLayout
                android:id="@+id/card_next_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servis berikutnya"
                    android:textColor="@color/muted_color"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tv_main_comp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Oli Mesin"
                    android:textColor="@color/ink_color"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <!-- Progress Bar Container -->
                <ProgressBar
                    android:id="@+id/pb_main_service"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp"
                    android:progress="70"
                    android:progressDrawable="@drawable/bg_button_primary"/>

                <TextView
                    android:id="@+id/tv_main_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sisa 800 km"
                    android:textColor="@color/ink_color"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <!-- Status Chip -->
                <TextView
                    android:id="@+id/tv_main_status_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_chip_ok"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Aman"
                    android:textColor="@color/green_color"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_main_schedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jadwal: 14.000 km atau 24 Nov 2026"
                    android:textColor="@color/muted_color"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btn_record_main_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:text="Catat servis ini"
                    android:textColor="@color/accent_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"/>

            </LinearLayout>

            <!-- Other Components Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:text="Komponen lain"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- RecyclerView Other Components Mini List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_other_components"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>