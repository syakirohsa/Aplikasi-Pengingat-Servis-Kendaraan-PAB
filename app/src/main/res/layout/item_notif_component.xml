<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/view_dot_indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notif_comp_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oli Mesin"
            android:textColor="@color/ink_color"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notif_sub1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sisa 300 km · 5 hari lagi"
            android:textColor="@color/muted_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_notif_sub2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Jadwal: 14.000 km atau 24 Nov 2026"
            android:textColor="@color/muted_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_record_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="4dp"
            android:text="Catat servis"
            android:textColor="@color/accent_color"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/sw_notif_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:useMaterialThemeColors="true"/>

</LinearLayout>