<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_profil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:background="@color/surface_color">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil"
            android:textColor="@color/ink_color"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header_layout"
        android:background="@color/line_color"/>

    <!-- Bottom Navigation View -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_color"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/accent_color"
        app:itemTextColor="@color/accent_color"
        app:elevation="8dp"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_divider"
        android:layout_above="@id/bottom_navigation"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- User Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp">

                    <ImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circle"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Foto Profil"/>

                    <TextView
                        android:id="@+id/tv_avatar_initial"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/on_accent_color"
                        android:textSize="28sp"
                        android:textStyle="bold"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budi Santoso"
                        android:textColor="@color/ink_color"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="budi@email.com"
                        android:textColor="@color/muted_color"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/accent_color"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Edit Profil"/>

            </LinearLayout>

            <!-- Motor Saya Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:text="Motor saya"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- RecyclerView Motor List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_vehicles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- Add Vehicle Button -->
            <Button
                android:id="@+id/btn_add_vehicle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="+ Tambah motor"
                android:textColor="@color/ink_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="Logout"
                android:textColor="@color/red_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>