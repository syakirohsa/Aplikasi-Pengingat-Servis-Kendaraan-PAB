<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_identitas_kendaraan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:background="@color/surface_color">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ink_color"
            android:contentDescription="Kembali"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Identitas Motor"
            android:textColor="@color/ink_color"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_color"/>

    <ScrollView
        android:id="@+id/scroll_identitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nama panggilan motor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama panggilan motor"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="Contoh: Si Merah"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <!-- Tipe motor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tipe motor"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_type"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="Contoh: Vario 125"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <!-- Merk -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Merk"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_brand"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="Contoh: Honda"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <!-- Tahun -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tahun"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_year"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="2021"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <!-- Plat nomor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Plat nomor"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_plate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="B 1234 XYZ"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <!-- Warna Motor Palette -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warna motor: "
                    android:textColor="@color/muted_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_selected_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Merah"
                    android:textColor="@color/ink_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Color Palette Chips Flow/Flex -->
            <LinearLayout
                android:id="@+id/layout_color_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- KM saat ini -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="KM saat ini"
                android:textColor="@color/muted_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_veh_km"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="13200"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ink_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_veh_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="18dp"
                android:textColor="@color/red_color"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/surface_color">

        <Button
            android:id="@+id/btn_save_vehicle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:text="Simpan"
            android:textColor="@color/on_accent_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>