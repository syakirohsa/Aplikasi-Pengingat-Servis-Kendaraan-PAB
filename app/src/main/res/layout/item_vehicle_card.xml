<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <View
        android:id="@+id/view_vehicle_color"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_vehicle_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Si Merah"
            android:textColor="@color/ink_color"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_vehicle_item_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Honda Vario 125 · B 1234 XYZ\n13.200 km"
            android:textColor="@color/muted_color"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_edit_vehicle_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:text="Ubah"
        android:textColor="@color/accent_color"
        android:textSize="14sp"
        android:textStyle="bold"
        style="?android:attr/borderlessButtonStyle"/>

</LinearLayout>